/* 千寻影集 - 暗色主题
   色值全部来自 src/ui/theme.py，本文件里的占位符（前后各一个 @ 包住
   大写常量名）由 theme.load_qss() 在启动时替换；写错或漏定义会在启动
   时直接抛错，不会静默渲染成透明。改配色只改 theme.py 一处，
   这里不要写字面色值。 */

/* 只给容器铺底色。
   早先这里是 `QWidget { background-color }` 全局铺，每个复合控件都继承
   不透明底，只好在 QLabel 和 MainWindow 里逐点补 transparent，补丁越加越多。
   子控件默认不铺底，直接透出父容器，就不再需要那些补丁。 */
@CONTAINER_SELECTOR@ {
    background-color: @BG_APP@;
    color: @FG_PRIMARY@;
}

QWidget {
    color: @FG_PRIMARY@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}
QToolBar {
    background: @TOOLBAR_BG@;
    border: none;
    spacing: 6px;
    padding: 5px 8px;
}
QPushButton {
    background: @INPUT_BG@;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton:hover { background: @INPUT_HOVER@; }
QPushButton:pressed { background: @INPUT_PRESSED@; }
QPushButton:checked {
    background: @SELECTED_BG@;
    border-color: @SELECTED_BG@;
    color: @FG_ON_ACCENT@;
}
QPushButton:disabled { color: @DISABLED_FG@; background: @DISABLED_BG@; }
QComboBox, QLineEdit, QSpinBox {
    background: @INPUT_BG@;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 20px;
}
QComboBox QAbstractItemView {
    background: @DISABLED_BG@;
    selection-background-color: @SELECTED_BG@;
    border: 1px solid @INPUT_BORDER@;
}
QComboBox::drop-down { border: none; width: 18px; }
QSlider::groove:horizontal {
    height: 4px;
    background: @INPUT_BORDER@;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border-radius: 7px;
    background: @ACCENT@;
}
QSlider::sub-page:horizontal { background: @ACCENT@; border-radius: 2px; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid @INPUT_BORDER@;
    border-radius: 3px;
    background: @INPUT_BG@;
}
QCheckBox::indicator:checked { background: @SELECTED_BG@; border-color: @SELECTED_BG@; }
QStatusBar { background: @TOOLBAR_BG@; color: @FG_SECONDARY@; }
QListView { background: @BG_APP@; border: none; outline: none; }
QScrollBar:vertical {
    background: @BG_APP@;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: @SCROLL_HANDLE@;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: @SCROLL_HOVER@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: @BG_APP@; height: 10px; }
QScrollBar::handle:horizontal {
    background: @SCROLL_HANDLE@;
    border-radius: 5px;
    min-width: 30px;
}
QMenu {
    background: @MENU_BG@;
    border: 1px solid @INPUT_BORDER@;
    padding: 4px;
}
QMenu::item { padding: 5px 24px; border-radius: 3px; }
QMenu::item:selected { background: @SELECTED_BG@; }
QToolTip {
    background: @MENU_BG@;
    color: @FG_PRIMARY@;
    border: 1px solid @INPUT_BORDER@;
    padding: 3px;
}

/* 表格与表头。
   Fusion 的表头默认按系统浅色画，本文件又给 QWidget 设了浅色文字，
   于是暗色主题下表头是「浅底 + 浅字」，分享记录和查重面板的列标题
   基本看不见。表头、表体、隔行底色全部收到调色板里，两套主题各自成立。 */
QTableWidget, QTableView {
    background: @BG_CARD@;
    alternate-background-color: @BG_APP@;
    gridline-color: @BORDER@;
    border: 1px solid @BORDER@;
    selection-background-color: @BG_CARD_SEL@;
    selection-color: @FG_PRIMARY@;
}
QTableWidget::item, QTableView::item { padding: 3px 6px; }
QHeaderView { background: @TOOLBAR_BG@; }
QHeaderView::section {
    background: @TOOLBAR_BG@;
    color: @FG_SECONDARY@;
    border: none;
    border-right: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER@;
    padding: 5px 6px;
}
QTableCornerButton::section { background: @TOOLBAR_BG@; border: none; }

/* 滚动条：配色也在调色板里，浅色主题下不能还是深灰 */
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @SCROLL_HANDLE@;
    border-radius: 4px;
    min-height: 28px;
    min-width: 28px;
}
QScrollBar::handle:hover { background: @SCROLL_HOVER@; }
